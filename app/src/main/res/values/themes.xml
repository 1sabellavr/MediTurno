<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.MediTurno" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/azul_primario</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/azul_claro</item>
        <item name="colorOnPrimaryContainer">@color/azul_oscuro</item>
        <item name="colorSecondary">@color/verde_secundario</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/verde_claro</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/texto_principal</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="Theme.MediTurno" parent="Base.Theme.MediTurno" />

    <!-- Menú desplegable de la barra superior: texto oscuro sobre fondo claro -->
    <style name="ThemeOverlay.MediTurno.Popup" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColorPrimary">@color/texto_principal</item>
        <item name="android:textColorSecondary">@color/texto_secundario</item>
        <item name="android:textColor">@color/texto_principal</item>
    </style>
</resources>